{
  "name": "pino-team-os",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-bo-public-views.mjs && next dev",
    "build": "node scripts/build-bo-public-views.mjs && next build && node scripts/pap659-build-provenance.mjs .next",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 lib/*.test.ts",
    "test:e2e": "playwright test",
    "bo:contract:check": "node scripts/verify-bo-module-contract.mjs && node --test scripts/verify-bo-module-contract.test.mjs",
    "bo:module:new": "node scripts/create-bo-module.mjs",
    "delivery:enter": "node scripts/delivery-entry.mjs",
    "pino:resume": "node scripts/delivery-entry.mjs",
    "pino:verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@notionhq/client": "^5.6.0",
    "@opennextjs/cloudflare": "1.20.12",
    "jose": "^6.2.12",
    "next": "16.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.54.2",
    "@types/node": "^20.19.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.33.0",
    "eslint-config-next": "16.4.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.0",
    "esbuild": "0.28.2",
    "postcss": "8.5.23"
  }
}
