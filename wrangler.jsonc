{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"pino-team-os",
  "main":".open-next/worker.js",
  "compatibility_date":"2026-08-11",
  "compatibility_flags":["nodejs_compat"],
  "assets":{"binding":"ASSETS","directory":".open-next/assets"},
  "observability":{"enabled":true},
  // CF_ACCESS_BO_AUD is environment-specific deployment configuration and is intentionally not committed.
  // Production ingress is a separate gated operation; source deploys must not attach TOS/BO custom domains implicitly.
  "vars":{"FOUNDER_EMAIL":"minhtri.van42@gmail.com,chuthhang@gmail.com"},
  "services":[
    {"binding":"PINO_CORE","service":"pino-core","entrypoint":"FounderControlPlane"},
    {"binding":"PINO_WORKFORCE_CORE","service":"pino-core","entrypoint":"WorkforceControlPlane"},
    {"binding":"PINO_BO_CORE","service":"pino-core","entrypoint":"BoAccessControlPlane"},
    {"binding":"PINO_TOS_LEARNING_CORE","service":"pino-core","entrypoint":"TosLearningControlPlane"}
  ],
  "keep_vars":true
}
