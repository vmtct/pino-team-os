{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"pino-team-os",
  "main":".open-next/worker.js",
  "compatibility_date":"2026-08-11",
  "compatibility_flags":["nodejs_compat"],
  "assets":{"binding":"ASSETS","directory":".open-next/assets"},
  "observability":{"enabled":true},
  "vars":{"FOUNDER_EMAIL":"minhtri.van42@gmail.com,chuthhang@gmail.com"},
  "services":[
    {"binding":"PINO_CORE","service":"pino-core","entrypoint":"FounderControlPlane"},
    {"binding":"PINO_WORKFORCE_CORE","service":"pino-core","entrypoint":"WorkforceControlPlane"}
  ],
  "routes":[
    {"pattern":"tos.pinohouse.art","custom_domain":true},
    {"pattern":"team.pinohouse.art","custom_domain":true}
  ],
  "keep_vars":true
}
