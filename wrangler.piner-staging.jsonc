{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "piner-space-staging",
  "main": "piner-staging-worker.mjs",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "vars": {
    "APP_ENV": "staging",
    "PINER_AUTH_STAGING_ENABLED": "false",
    "PINER_AFTERSCHOOL_PIN_BFF_ENABLED": "false"
  },
  "services": [
    {
      "binding": "PINO_MEMBER_CORE",
      "service": "pino-core-staging"
    },
    {
      "binding": "PINO_AFTERSCHOOL_CORE",
      "service": "pino-core-staging"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PINER_AUTH_RATE_GUARD",
        "class_name": "PinerOtpRateGuard"
      },
      {
        "name": "PINER_AFTERSCHOOL_RATE_GUARD",
        "class_name": "PinerAfterschoolRateGuard",
        "script_name": "piner-afterschool-rate-guard-staging"
      }
    ]
  },
  "migrations": [
    {
      "tag": "pap1837-piner-auth-rate-v1",
      "new_sqlite_classes": [
        "PinerOtpRateGuard"
      ]
    }
  ]
}
