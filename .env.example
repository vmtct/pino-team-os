# Required for the current Staff module
NOTION_TOKEN=
NOTION_STAFF_DB_ID=

# Cloudflare Access — required in production
# Example: https://pino-team.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUDIENCE=

# Server-side authorization for /team.
# Use the exact App Access option names configured in Notion, comma-separated.
PINO_TEAM_ACCESS=Admin,Manager

# Required only when the corresponding module is enabled
NOTION_SHIFT_MASTER_DB_ID=
NOTION_SCHEDULE_DB_ID=
NOTION_TIMESHEET_DB_ID=
NOTION_TRAINING_DB_ID=
NOTION_PROGRAMS_DB_ID=
