{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pino-team-os-toppi-staging",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": { "enabled": true },
  "workers_dev": true,
  "vars": {
    "TOPPI_STAGING_MODE": "canonical-synthetic",
    "TOPPI_STAGING_CENTER_ID": "00000000-0000-7000-8000-000000000001"
  },
  "services": [
    { "binding": "PINO_BO_CORE", "service": "pino-core-staging", "entrypoint": "BoAccessControlPlane" }
  ]
}
