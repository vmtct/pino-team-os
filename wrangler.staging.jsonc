{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pino-team-os-staging",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "binding": "ASSETS", "directory": ".open-next/assets" },
  "observability": { "enabled": true },
  "send_email": [{ "name": "PINO_STAFF_PASSWORD_EMAIL" }],
  "vars": {
    "FOUNDER_EMAIL": "minhtri.van42@gmail.com,chuthhang@gmail.com",
    "STAFF_PASSWORD_RESET_FROM_EMAIL": "no-reply@pinohouse.art",
    "PINORIA_TV_STAGING_BYPASS": "enabled",
    "PINORIA_TOS_STAGING_BYPASS": "enabled",
    "PINORIA_BO_STAGING_BYPASS": "enabled",
    "WORKFORCE_BO_STAGING_BYPASS": "enabled",
    "WORKFORCE_STAGING_BO_EMAIL": "workforce-planning-staging-probe@pino.invalid",
    "OPEN_STUDIO_BO_STAGING_BYPASS": "enabled",
    "OPEN_STUDIO_STAGING_BO_EMAIL": "open-studio-control-loop-staging-probe@pino.invalid",
    "PINORIA_STAGING_STAFF_EMAIL": "workforce-tos-final-1788152650000@pino.invalid",
    "WORKFORCE_CENTER_NETWORK_STAGING_INGRESS": "enabled"
  },
  "services": [
    { "binding": "PINO_CORE", "service": "pino-core-staging", "entrypoint": "FounderControlPlane" },
    { "binding": "PINO_WORKFORCE_CORE", "service": "pino-core-staging", "entrypoint": "WorkforceControlPlane" },
    { "binding": "PINO_WORKFORCE_NETWORK_CORE", "service": "pino-core-staging", "entrypoint": "WorkforceNetworkPresenceControlPlane" },
    { "binding": "PINO_BO_CORE", "service": "pino-core-staging", "entrypoint": "BoAccessControlPlane" },
    { "binding": "PINO_STAFF_REGISTRATION_CORE", "service": "pino-core-staging", "entrypoint": "StaffRegistrationControlPlane" },
    { "binding": "PINO_TOS_LEARNING_CORE", "service": "pino-core-staging", "entrypoint": "TosLearningControlPlane" },
    { "binding": "PINO_STAFF_PASSWORD_CORE", "service": "pino-core-staging", "entrypoint": "StaffPasswordControlPlane" },
    { "binding": "PINO_PINORIA_TV_CORE", "service": "pino-core-staging", "entrypoint": "PinoriaTvControlPlane" }
  ],
  "keep_vars": true
}