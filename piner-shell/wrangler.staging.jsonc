{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "piner-app-shell-staging",
  "main": "src/staging-worker.mjs",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": { "APP_ENV": "staging", "PINER_SYNTHETIC_REVIEW_ENABLED": "false" },
  "services": [
    { "binding": "AFTERSCHOOL_PIN_WORKER", "service": "piner-space-staging" },
    { "binding": "PINER_SYNTHETIC_REVIEW", "service": "piner-space-staging", "entrypoint": "PinerSyntheticReviewControlPlane" }
  ],
  "r2_buckets": [
    { "binding": "PINER_BRAND_R2", "bucket_name": "app-piner" }
  ]
}
