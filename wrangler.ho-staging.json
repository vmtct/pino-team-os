{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pino-team-os-staging",
  "main": "worker.ho-staging.mjs",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets",
    "run_worker_first": [
      "/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "staging",
    "PAP1523_PERSON_SUPPORT_FIXTURE": "1",
    "PAP2153_AVATAR_WORLD_FIXTURE": "1",
    "FOUNDER_EMAIL": "",
    "BO_UI_ONLY": "enabled",
    "BO_MISSION_ASSIGNMENT_M1_REVIEW": "enabled",
    "HO_PILOT_FOUNDER_USER_IDS": "01a208c5-d735-7188-9fc2-e114ee549820"
  },
  "services": [
    {
      "binding": "PINO_CORE",
      "service": "pino-core-staging",
      "entrypoint": "FounderControlPlane"
    },
    {
      "binding": "PINO_WORKFORCE_CORE",
      "service": "pino-core-staging",
      "entrypoint": "WorkforceControlPlane"
    },
    {
      "binding": "PINO_WORKFORCE_NETWORK_CORE",
      "service": "pino-core-staging",
      "entrypoint": "WorkforceNetworkPresenceControlPlane"
    },
    {
      "binding": "PINO_BO_CORE",
      "service": "pino-core-staging",
      "entrypoint": "BoAccessControlPlane"
    },
    {
      "binding": "PINO_HO_ITEM_CORE",
      "service": "pino-core-staging",
      "entrypoint": "HoPinoriaItemControlPlane"
    },
    {
      "binding": "PINO_HO_WORLD_CORE",
      "service": "pino-core-staging",
      "entrypoint": "HoWorldControlPlane"
    },
    {
      "binding": "PINO_HO_EDITORIAL_CORE",
      "service": "pino-core-staging",
      "entrypoint": "HoEditorialControlPlane"
    },
    {
      "binding": "PINO_STAFF_REGISTRATION_CORE",
      "service": "pino-core-staging",
      "entrypoint": "StaffRegistrationControlPlane"
    },
    {
      "binding": "PINO_TOS_LEARNING_CORE",
      "service": "pino-core-staging",
      "entrypoint": "TosLearningControlPlane"
    },
    {
      "binding": "PINO_STAFF_PASSWORD_CORE",
      "service": "pino-core-staging",
      "entrypoint": "StaffPasswordControlPlane"
    },
    {
      "binding": "PINO_PINORIA_TV_CORE",
      "service": "pino-core-staging",
      "entrypoint": "PinoriaTvControlPlane"
    },
    {
      "binding": "PINO_TV_RUNTIME_CORE",
      "service": "pino-core-staging",
      "entrypoint": "DisplayRuntimeControlPlane"
    }
  ],
  "keep_vars": false
}
