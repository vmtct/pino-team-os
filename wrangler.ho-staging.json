{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pino-team-os-staging",
  "main": "worker.ho-staging.mjs",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets",
    "run_worker_first": [
      "/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "staging",
    "FOUNDER_EMAIL": "",
    "BO_UI_ONLY": "enabled",
    "HO_PILOT_FOUNDER_USER_IDS": "01a0b2aa-9e9e-7cb5-943f-110671d0da62,01a18784-3c28-7ed7-b114-c2c83502c30f"
  },
  "services": [
    {
      "binding": "PINO_CORE",
      "service": "pino-core-staging",
      "entrypoint": "FounderControlPlane"
    },
    {
      "binding": "PINO_WORKFORCE_CORE",
      "service": "pino-core-staging",
      "entrypoint": "WorkforceControlPlane"
    },
    {
      "binding": "PINO_WORKFORCE_NETWORK_CORE",
      "service": "pino-core-staging",
      "entrypoint": "WorkforceNetworkPresenceControlPlane"
    },
    {
      "binding": "PINO_BO_CORE",
      "service": "pino-core-staging",
      "entrypoint": "BoAccessControlPlane"
    },
    {
      "binding": "PINO_HO_ITEM_CORE",
      "service": "pino-core-staging",
      "entrypoint": "HoPinoriaItemControlPlane"
    },
    {
      "binding": "PINO_STAFF_REGISTRATION_CORE",
      "service": "pino-core-staging",
      "entrypoint": "StaffRegistrationControlPlane"
    },
    {
      "binding": "PINO_TOS_LEARNING_CORE",
      "service": "pino-core-staging",
      "entrypoint": "TosLearningControlPlane"
    },
    {
      "binding": "PINO_STAFF_PASSWORD_CORE",
      "service": "pino-core-staging",
      "entrypoint": "StaffPasswordControlPlane"
    },
    {
      "binding": "PINO_PINORIA_TV_CORE",
      "service": "pino-core-staging",
      "entrypoint": "PinoriaTvControlPlane"
    }
  ],
  "keep_vars": false
}
